# Copy this file to .env and fill in your own values. .env is git-ignored.

# Google AI Studio key used by the FastAPI service to call Gemini.
GOOGLE_API_KEY=your-gemini-api-key
# Optional: any Gemini model that supports structured output.
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL credentials, shared by the database and the Spring Boot backend.
POSTGRES_USER=fitvision
POSTGRES_PASSWORD=change-me

# Only used when running the backend outside Docker (application.properties).
DB_PASSWORD=change-me
FASTAPI_BASE_URL=http://localhost:8000
